<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is only for the optional Draw Together friend rooms
         (PeerJS signalling). AR Trace, the built-in drawings, photo
         import and Pivot Mate all work offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Camera: AR Trace uses the phone camera only, never the Wyze cam. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Photo import: pick a photo from the phone's gallery. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Camera is optional: the app still opens and draws without it,
         AR Trace just cannot start. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher_round"
        android:label="Sketchmate AR"
        android:supportsRtl="true"
        android:theme="@style/Theme.SketchmateAR">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
